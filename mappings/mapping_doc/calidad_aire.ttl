<observation_CO_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "calidad_aire_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://example.org/recurso/observacion/{_id}/CO";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintmed:EnvironmentalObservation;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:madeBySensor;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensor/{refDevice}/CO";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:observedProperty;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintkos-vars:COConcentration;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hasFeatureOfInterest;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintkos-foi:Air;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:phenomenonTime;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/instante/{_id}";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hasResult;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/resultadoObservacion/{_id}/CO";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:publisher;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "dataProvider";
			rr:datatype xsd:anyURI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:source;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "source";
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:identifier;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "{entityId}-{_id}-CO";
			rr:termType rr:Literal
		];
	].


