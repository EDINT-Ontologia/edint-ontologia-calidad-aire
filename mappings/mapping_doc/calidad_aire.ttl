@prefix edintmed: <https://edint.es/def/medio-ambiente#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>.
@prefix gsp: <http://www.opengis.net/ont/geosparql#>.
@prefix sosa: <http://www.w3.org/ns/sosa/>.
@prefix qudt: <http://qudt.org/schema/qudt/>.
@prefix edintkos-vars: <https://edint.es/kos/edint/EnvironmentalProperty/>.
@prefix edintkos-sensortypes: <https://edint.es/kos/edint/sensortypes/>.
@prefix edintkos-foi: <https://edint.es/kos/edint/foi/>.
@prefix unit: <http://qudt.org/vocab/unit/>.
@prefix time: <http://www.w3.org/2006/time#>.
@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix schema: <http://schema.org/>.
@prefix formats: <http://www.w3.org/ns/formats/>.
@prefix comp: <http://semweb.mmlab.be/ns/rml-compression#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.
@base <http://example.com/ns#>.


<sensor_platform_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "calidad_aire_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://example.org/recurso/estacion-de-sensores/{refDevice}";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintmed:SensorPlatform;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:identifier;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "refDevice";
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant gsp:hasGeometry;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/geometria/{refDevice}";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hosts;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensor/{refDevice}/CO";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hosts;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensor/{refDevice}/H2S";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hosts;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensor/{refDevice}/NO";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hosts;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensor/{refDevice}/NO2";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hosts;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensor/{refDevice}/O3";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hosts;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensor/{refDevice}/SO2";
			rr:termType rr:IRI
		];
	].


<platform_geometry_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "calidad_aire_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://example.org/recurso/geometria/{refDevice}";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant gsp:Geometry;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant gsp:asGeoJSON;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "location";
			rr:datatype gsp:geoJSONLiteral
		];
	].


