<?xml version="1.0"?>
<rdf:RDF xmlns="https://edint.es/def/calidad-aire#"
     xml:base="https://edint.es/def/calidad-aire"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:vann="http://purl.org/vocab/vann/">

    <owl:Ontology rdf:about="https://edint.es/def/calidad-aire#">
        <owl:versionIRI rdf:resource="https://edint.es/def/calidad-aire/0.1.0"/>
        <owl:imports rdf:resource="https://edint.es/def/medio-ambiente#"/>
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <dcterms:title xml:lang="en">EDINT Environmental Sensors Ontology, Air Quality Case</dcterms:title>
        <dcterms:title xml:lang="es">Ontología EDINT de Sensores Medioambientales, caso Calidad del Aire</dcterms:title>
        <dcterms:abstract xml:lang="en">Ontology for representing air quality data. It reuses the Environmental Sensors pattern to represent stations, sensors and air quality observations (NO2, O3, PM10, etc.).</dcterms:abstract>
        <dcterms:abstract xml:lang="es">Ontología para la representación de datos de calidad del aire. Reutiliza el patrón de Sensores Medioambientales para representar estaciones, sensores y observaciones de calidad del aire (NO2, O3, PM10, etc.).</dcterms:abstract>
        <dcterms:description xml:lang="en">Ontology for representing air quality data. It reuses the Environmental Sensors pattern to represent stations, sensors and air quality observations (NO2, O3, PM10, etc.).</dcterms:description>
        <dcterms:description xml:lang="es">Ontología para la representación de datos de calidad del aire. Reutiliza el patrón de Sensores Medioambientales para representar estaciones, sensores y observaciones de calidad del aire (NO2, O3, PM10, etc.).</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <vann:preferredNamespacePrefix>edintcalaire</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/calidad-aire#"/>
    </owl:Ontology>
</rdf:RDF>
